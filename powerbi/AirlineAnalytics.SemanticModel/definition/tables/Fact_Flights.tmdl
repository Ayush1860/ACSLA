	partition Fact_Flights = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "fact_flights.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {{"passenger_id", Int64.Type}, {"customer_id", Int64.Type}, {"travel_id", Int64.Type}, {"age", Int64.Type}, {"flight_distance", Int64.Type}, {"dep_delay", Int64.Type}, {"arr_delay", Int64.Type}, {"delay_bucket", type text}, {"delay_bucket_order", Int64.Type}, {"is_delayed_15", Int64.Type}, {"avg_service_rating", type number}, {"services_not_applicable", Int64.Type}, {"is_satisfied", Int64.Type}, {"satisfaction", type text}, {"source_split", type text}}, "en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
